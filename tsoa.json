{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controller/**/*Controller.ts"
  ],
  "spec": {
    "outputDirectory": "src/swagger",
    "specVersion": 3,
    "name": "Pacioli API",
    "description": "Documentacao da API Pacioli",
    "version": "1.0.0"
  },
  "routes": {
    "routesDir": "src/routes",
    "middleware": "express"
  }
}