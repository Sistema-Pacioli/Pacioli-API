// use prisma-8

enum TipoConta {
  @@type("pg/text@1")
  Ativo
  Passivo
  PatrimonioLiquido
  Receita
  Despesa
}

model Empresa {
  id   Int    @id @default(autoincrement())
  nome String
  cnpj String @unique

  planoDeContas PlanoDeContas?
  lancamentos   Lancamento[]

  @@map("empresa")
}

model PlanoDeContas {
  id        Int @id @default(autoincrement())
  empresaId Int @unique

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  contas  ContaContabil[]

  @@map("plano_de_contas")
}

model ContaContabil {
  id              Int       @id @default(autoincrement())
  planoDeContasId Int
  codigo          String
  nome            String
  tipo            TipoConta
  subtipo         String?

  planoDeContas      PlanoDeContas @relation(fields: [planoDeContasId], references: [id])
  lancamentosDebito  Lancamento[]  @relation("LancamentoDebito")
  lancamentosCredito Lancamento[]  @relation("LancamentoCredito")

  @@unique([planoDeContasId, codigo])
  @@index([planoDeContasId])
  @@map("conta_contabil")
}

model Lancamento {
  id             Int            @id @default(autoincrement())
  empresaId      Int
  contaDebitoId  Int
  contaCreditoId Int
  data           Date
  descricao      String
  valor          NumericString(15, 2)
  abertura       Boolean        @default(false)
  criadoEm       DateTime       @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  contaDebito  ContaContabil @relation("LancamentoDebito", fields: [contaDebitoId], references: [id])
  contaCredito ContaContabil @relation("LancamentoCredito", fields: [contaCreditoId], references: [id])

  @@index([empresaId, data])
  @@index([contaDebitoId])
  @@index([contaCreditoId])
  @@map("lancamento")
}